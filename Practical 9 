# Naive String Matching Algorithm

text = input("Enter Text : ")
pattern = input("Enter Pattern : ")

n = len(text)
m = len(pattern)

found = False

print("\nPattern Found at Index :")

for i in range(n - m + 1):
    match = True

    for j in range(m):
        if text[i + j] != pattern[j]:
            match = False
            break

    if match:
        print(i)
        found = True

if not found:
    print("Pattern Not Found")