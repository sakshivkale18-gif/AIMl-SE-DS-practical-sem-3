class Node:
    def __init__(self, data):
        self.data = data
        self.left = None
        self.right = None


# Insert
def insert(root, data):
    if root is None:
        return Node(data)

    if data < root.data:
        root.left = insert(root.left, data)
    else:
        root.right = insert(root.right, data)

    return root


# Search
def search(root, data):
    if root is None:
        return False

    if root.data == data:
        return True

    if data < root.data:
        return search(root.left, data)
    else:
        return search(root.right, data)


# Delete
def delete(root, data):
    if root is None:
        return root

    if data < root.data:
        root.left = delete(root.left, data)
    elif data > root.data:
        root.right = delete(root.right, data)
    else:
        if root.left is None:
            return root.right

        if root.right is None:
            return root.left

        temp = root.right
        while temp.left:
            temp = temp.left

        root.data = temp.data
        root.right = delete(root.right, temp.data)

    return root


# Inorder
def inorder(root):
    if root:
        inorder(root.left)
        print(root.data, end=" ")
        inorder(root.right)


# Preorder
def preorder(root):
    if root:
        print(root.data, end=" ")
        preorder(root.left)
        preorder(root.right)


# Postorder
def postorder(root):
    if root:
        postorder(root.left)
        postorder(root.right)
        print(root.data, end=" ")


# Depth
def depth(root):
    if root is None:
        return 0

    return max(depth(root.left), depth(root.right)) + 1


# Mirror
def mirror(root):
    if root:
        root.left, root.right = root.right, root.left
        mirror(root.left)
        mirror(root.right)


# Copy
def copy_tree(root):
    if root is None:
        return None

    new_root = Node(root.data)
    new_root.left = copy_tree(root.left)
    new_root.right = copy_tree(root.right)

    return new_root


# Parent nodes with children
def parent_nodes(root):
    if root:
        if root.left or root.right:
            print("Parent:", root.data, end=" ")

            if root.left:
                print("Left Child:", root.left.data, end=" ")

            if root.right:
                print("Right Child:", root.right.data, end=" ")

            print()

        parent_nodes(root.left)
        parent_nodes(root.right)


# Leaf nodes
def leaf_nodes(root):
    if root:
        if root.left is None and root.right is None:
            print(root.data, end=" ")

        leaf_nodes(root.left)
        leaf_nodes(root.right)


# Level-wise display
def level_order(root):
    if root is None:
        return

    queue = [root]

    while queue:
        temp = queue.pop(0)
        print(temp.data, end=" ")

        if temp.left:
            queue.append(temp.left)

        if temp.right:
            queue.append(temp.right)


