values = [50, 30, 70, 20, 40, 60, 80]

for value in values:
    root = insert(root, value)


print("Inorder Traversal:")
inorder(root)

print("\nPreorder Traversal:")
preorder(root)

print("\nPostorder Traversal:")
postorder(root)

